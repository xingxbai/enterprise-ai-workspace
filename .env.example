# 当前聊天模型提供方：deepseek 或 kimi
AI_CHAT_PROVIDER=deepseek

# DeepSeek 服务端配置，严禁使用 NEXT_PUBLIC_ 前缀
DEEPSEEK_API_KEY=请填写你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Kimi 服务端配置，严禁使用 NEXT_PUBLIC_ 前缀
KIMI_API_KEY=请填写你的Kimi密钥
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.7-code-highspeed

# 单次模型调用限制
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT_MS=60000

# 工单业务 API 可选配置；真实配置存在时始终优先使用真实数据源
TICKETS_API_BASE_URL=
TICKETS_API_TOKEN=

# 仅允许非生产环境使用学习演示种子数据；设为 false 可验证真实空状态
ENABLE_DEMO_FIXTURES=true
